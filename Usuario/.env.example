NODE_ENV=development
PORT=3000
DB_HOST=seu-servidor.mysql.database.azure.com
DB_PORT=3306
DB_USER=seu-usuario
DB_PASSWORD=
DB_NAME=ecowayer_db
JWT_SECRET=
JWT_EXPIRES_IN=1h
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AI_AGENT_URL=http://localhost:3333/api/v1/ai
AI_SECRET_TOKEN=
GOOGLE_MAPS_API_KEY=
CLOUDINARY_CLOUD_NAME=
GOOGLE_CLIENT_ID=
# Verificação de cadastro e recuperação de senha. Configure SMTP e Twilio para habilitar os dois canais.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
MP_APP_ID=3328498013279371
MP_ACCESS_TOKEN=
MP_TEST_MODE=0
MP_LIVE_ENABLED=0
# Somente se a EcoWayer for a recebedora e responsável por cada venda. Marketplace individual requer outro fluxo.
MP_SETTLEMENT_MODE=
MP_BACKEND_URL=http://localhost:3000
MP_FRONTEND_URL=http://localhost:5173
# Opcional em localhost: consulta manual/retorno continuam funcionando.
# Para webhook, use a assinatura secreta do painel e MP_BACKEND_URL HTTPS público.
MP_WEBHOOK_SECRET=
